{
    "skill_id": "calendar_skill",
    "name": "Create Calendar Event",
    "description": "Creates calendar events using Google Calendar API",
    "type": "google_calendar",
    "version": "1.0.0",
    "configuration": {
        "api_endpoint": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
        "authentication": {
            "type": "oauth2",
            "client_id": "${GOOGLE_CALENDAR_CLIENT_ID}",
            "client_secret": "${GOOGLE_CALENDAR_CLIENT_SECRET}",
            "scope": "https://www.googleapis.com/auth/calendar.events"
        }
    },
    "input_schema": {
        "type": "object",
        "required": [
            "summary",
            "start_date"
        ],
        "properties": {
            "summary": {
                "type": "string",
                "description": "Event title"
            },
            "description": {
                "type": "string",
                "description": "Event description"
            },
            "start_date": {
                "type": "string",
                "format": "date",
                "description": "Event start date (YYYY-MM-DD)"
            },
            "start_time": {
                "type": "string",
                "format": "time",
                "description": "Event start time (HH:MM) - defaults to 9:00 AM"
            },
            "duration_minutes": {
                "type": "integer",
                "description": "Event duration in minutes - defaults to 60"
            },
            "attendees": {
                "type": "array",
                "items": {
                    "type": "string",
                    "format": "email"
                },
                "description": "List of attendee email addresses"
            },
            "location": {
                "type": "string",
                "description": "Event location"
            }
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "event_id": {
                "type": "string",
                "description": "Google Calendar event ID"
            },
            "html_link": {
                "type": "string",
                "format": "uri",
                "description": "Link to view event in Google Calendar"
            },
            "status": {
                "type": "string",
                "description": "Event creation status"
            }
        }
    },
    "example": {
        "input": {
            "summary": "Orientation Session",
            "description": "Welcome orientation for new employee",
            "start_date": "2024-02-15",
            "start_time": "09:00",
            "duration_minutes": 120,
            "attendees": [
                "employee@company.com",
                "manager@company.com"
            ]
        },
        "output": {
            "event_id": "abc123xyz",
            "html_link": "https://calendar.google.com/calendar/event?eid=abc123xyz",
            "status": "created"
        }
    }
}
